# =============================================================================
# Pick Up — environment variables
# Copy this file to `.env` for local development and fill in real values.
# NEVER commit `.env` with real secrets. See README.md for full setup notes.
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Pick Up

# Any standard PostgreSQL connection string works: a managed provider
# (Neon, Supabase, Hostinger Cloud DB), a self-hosted VPS instance, or the
# `postgres` service in docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pickup?schema=public"

# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
SESSION_COOKIE_NAME=pickup_session

# --- Localization, currency, timezone ---------------------------------------
DEFAULT_TIMEZONE=Asia/Dhaka
NEXT_PUBLIC_TIMEZONE=Asia/Dhaka
DEFAULT_CURRENCY=BDT
NEXT_PUBLIC_CURRENCY=BDT
NEXT_PUBLIC_CURRENCY_SYMBOL=৳
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Business rules (also editable by admins at runtime via SiteSetting) ----
DEFAULT_COMMISSION_RATE_PCT=10

# --- Age-restricted products (tobacco module) --------------------------------
# Keep disabled until a legal/compliance review authorizes activation.
TOBACCO_SALES_ENABLED=false
TOBACCO_MINIMUM_AGE=18
TOBACCO_EXCLUSION_RADIUS_METERS=100

# --- Google Maps --------------------------------------------------------------
# Client key: restrict by HTTP referrer (your domain) and to Maps JavaScript
# API + Places API only. Server key (optional): restrict by IP and to the
# Geocoding API only. Leave blank in development to use the built-in
# simulated-map fallback.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# --- Payments (Bangladesh) ---------------------------------------------------
# Leave credentials blank to use the built-in sandbox/mock payment adapter,
# which is clearly labeled in the UI and never claims to move real money.
BKASH_MODE=sandbox
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

NAGAD_MODE=sandbox
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=

ROCKET_MODE=sandbox
ROCKET_MERCHANT_ID=
ROCKET_MERCHANT_SECRET=

SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# --- SMS ----------------------------------------------------------------------
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=

# --- Email ----------------------------------------------------------------------
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Pick Up <no-reply@pickup.example>"

# --- Object storage (S3-compatible) -------------------------------------------
# provider=local is for development only (writes under /public/uploads/dev).
# Use provider=s3 in production (Hostinger Object Storage, Wasabi,
# Cloudflare R2, AWS S3, MinIO, etc.) — see README "Storage" section.
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=
S3_FORCE_PATH_STYLE=true

# --- Support / contact defaults (seeded into SiteSetting, editable by admin) --
SUPPORT_PHONE=+8801700000000
SUPPORT_EMAIL=support@pickup.example
SUPPORT_ADDRESS="Khagrachari Sadar, Khagrachari, Chattogram, Bangladesh"
WHATSAPP_NUMBER=+8801700000000
NEXT_PUBLIC_WHATSAPP_NUMBER=+8801700000000

# --- Background jobs / cron endpoints ------------------------------------------
# Required bearer token for the location-retention and ad-lifecycle cron
# endpoints (see README "Background jobs").
CRON_SECRET=
