// Pick Up — Bangladesh multi-vendor marketplace
// Prisma schema. Locations, delivery zones and exclusion zones are fully
// database-driven so the administrator can expand coverage beyond
// Khagrachari Sadar without touching this file.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  VENDOR
  RIDER
  ADMIN
}

enum Locale {
  EN
  BN
}

enum BusinessType {
  GROCERY_VENDOR
  RESTAURANT
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum RegistrationPaymentMethod {
  BKASH
  NAGAD
  CASH
}

enum ProductAvailability {
  AVAILABLE
  OUT_OF_STOCK
  TEMPORARILY_UNAVAILABLE
}

enum OrderStatus {
  ORDER_PLACED
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  RIDER_ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
  FAILED_DELIVERY
  RETURNED
  REFUNDED
}

enum PaymentProvider {
  COD
  BKASH
  NAGAD
  ROCKET
  SSLCOMMERZ
  CARD
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationType {
  ORDER
  PAYMENT
  DELIVERY
  PROMOTION
  ACCOUNT
  SYSTEM
}

enum CoverageRequestStatus {
  PENDING
  PLANNED
  ACTIVATED
  DECLINED
}

enum AdPlacementCode {
  HERO_BANNER
  BELOW_CATEGORIES_BANNER
  BETWEEN_SECTIONS_BANNER
  RESTAURANT_PROMO_BANNER
  SIDEBAR_BANNER
  MOBILE_PROMO_CARD
  SPONSORED_VENDOR
  SPONSORED_RESTAURANT
  /// The redesigned carousel placements (see PLAN-redesign-ads) — the 8
  /// above are deprecated (deactivated, not deleted, so existing
  /// campaigns/payments keep their history) in favor of these two.
  HOMEPAGE_CAROUSEL
  MARKETPLACE_TOP
}

enum AdBillingCycle {
  DAILY
  WEEKLY
  MONTHLY
}

enum AdStatus {
  DRAFT
  SUBMITTED
  PAYMENT_PENDING
  UNDER_REVIEW
  APPROVED
  SCHEDULED
  ACTIVE
  PAUSED
  EXPIRED
  REJECTED
  CANCELLED
}

enum AdPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ExclusionZoneCategory {
  SCHOOL
  HOSPITAL
  CLINIC
  CHILDRENS_PARK
  PLAYGROUND
  SPORTS_VENUE
  OTHER
}

enum IdDocumentType {
  NATIONAL_ID
  BIRTH_CERTIFICATE
  PASSPORT
  DRIVING_LICENSE
}

enum AgeVerificationResult {
  VERIFIED
  FAILED
  NOT_ATTEMPTED
}

// ---------------------------------------------------------------------------
// Identity & accounts
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  role          UserRole
  name          String
  email         String?   @unique
  phone         String    @unique
  passwordHash  String
  locale        Locale    @default(EN)
  avatarUrl     String?
  isActive      Boolean   @default(true)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  customerProfile CustomerProfile?
  vendorProfile   Vendor?
  riderProfile    RiderProfile?

  addresses        Address[]
  cart             Cart?
  wishlist         Wishlist?
  favoriteVendors  FavoriteVendor[]
  orders           Order[]            @relation("CustomerOrders")
  orderGroups      OrderGroup[]
  reviews          Review[]
  notifications    Notification[]
  supportTickets   SupportTicket[]    @relation("TicketRequester")
  ticketReplies    SupportTicketMessage[]
  coverageRequests CoverageRequest[]
  auditLogs        AuditLog[]         @relation("AuditActor")
  advertiserProfile Advertiser?
  statusChanges    DeliveryStatusHistory[] @relation("StatusChangedBy")
  ageVerifications AgeVerification[]
  createdRiderLedgerEntries RiderLedgerEntry[]

  @@index([role])
}

model CustomerProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth   DateTime?
  loyaltyPoints Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model RiderProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType       String?
  licenseNumber     String?
  // NID number is admin-only — never render it on any rider-facing or public
  // page, and never pass it to recordAuditLog or any other logging.
  nationalIdNo      String?
  nationalIdDocKey  String?
  licenseCheckedInOffice Boolean @default(false)
  photoCheckedInOffice   Boolean @default(false)
  adminNote         String?
  isOnline          Boolean   @default(false)
  isApproved        Boolean   @default(false)
  currentLat        Decimal?  @db.Decimal(9, 6)
  currentLng        Decimal?  @db.Decimal(9, 6)
  currentLocationAt DateTime?
  ratingAvg         Decimal   @default(0) @db.Decimal(2, 1)
  ratingCount       Int       @default(0)
  // This rider's own commission rate — set by admin, defaults to the
  // site-wide default_rider_commission_rate_pct setting for new riders.
  commissionRatePct Decimal   @default(25) @db.Decimal(5, 2)
  // Cached running balance, in poisha. Positive = rider owes the platform;
  // negative = platform owes the rider. Updated transactionally alongside
  // every RiderLedgerEntry insert — never derived on read (see lib/rider/ledger.ts).
  balancePoisha     Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  deliveries       Delivery[]
  locationUpdates  RiderLocationUpdate[]
  restrictedLogs   RestrictedDeliveryLog[]
  ledgerEntries    RiderLedgerEntry[]
}

// ---------------------------------------------------------------------------
// Location system — fully dynamic (Division -> District -> Upazila -> Town ->
// Neighbourhood), decoupled from any hard-coded place names. ServiceArea
// activates a place for ordering; DeliveryZone controls fees/ETAs within it.
// ---------------------------------------------------------------------------

model Division {
  id        String     @id @default(cuid())
  name      String
  nameBn    String?
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  districts District[]
}

model District {
  id         String    @id @default(cuid())
  divisionId String
  division   Division  @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  name       String
  nameBn     String?
  slug       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  upazilas   Upazila[]
  towns      Town[]

  @@unique([divisionId, slug])
}

/// Deprecated — the business only ever operates by zila (district) and town,
/// never upazila. `Town.upazilaId` is being phased out in favor of
/// `Town.districtId` (see PLAN-remove-upazila); this model and its FK on
/// Town stay only until a follow-up migration drops them, to keep the
/// deploy an additive expand/contract instead of one breaking cutover.
model Upazila {
  id         String    @id @default(cuid())
  districtId String
  district   District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  name       String
  nameBn     String?
  slug       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  towns      Town[]

  @@unique([districtId, slug])
}

model Town {
  id            String          @id @default(cuid())
  /// Deprecated, nullable so new towns can omit it — see Upazila's doc comment.
  upazilaId     String?
  upazila       Upazila?        @relation(fields: [upazilaId], references: [id], onDelete: Cascade)
  districtId    String
  district      District        @relation(fields: [districtId], references: [id], onDelete: Cascade)
  name          String
  nameBn        String?
  slug          String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  neighbourhoods Neighbourhood[]
  serviceAreas  ServiceArea[]

  @@unique([upazilaId, slug])
  @@unique([districtId, slug])
}

model Neighbourhood {
  id           String    @id @default(cuid())
  townId       String
  town         Town      @relation(fields: [townId], references: [id], onDelete: Cascade)
  name         String
  nameBn       String?
  slug         String
  wardNumber   String?
  centerLat    Decimal?  @db.Decimal(9, 6)
  centerLng    Decimal?  @db.Decimal(9, 6)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  deliveryZones DeliveryZone[]
  addresses     Address[]

  @@unique([townId, slug])
}

/// A ServiceArea is a town (or town + surrounding area) the platform has
/// switched on for ordering. Inactive service areas can still be browsed
/// but cannot receive orders — this is how expansion happens without code
/// changes.
model ServiceArea {
  id          String   @id @default(cuid())
  townId      String
  town        Town     @relation(fields: [townId], references: [id], onDelete: Cascade)
  name        String
  nameBn      String?
  isActive    Boolean  @default(false)
  launchedAt  DateTime?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveryZones DeliveryZone[]

  @@index([isActive])
}

model DeliveryZone {
  id                  String    @id @default(cuid())
  serviceAreaId       String
  serviceArea         ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  neighbourhoodId     String?
  neighbourhood       Neighbourhood? @relation(fields: [neighbourhoodId], references: [id])
  name                String
  nameBn              String?
  isActive            Boolean   @default(true)
  deliveryFee         Decimal   @db.Decimal(10, 2)
  freeDeliveryThreshold Decimal? @db.Decimal(10, 2)
  estimatedMinutesMin Int
  estimatedMinutesMax Int
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  boundary  DeliveryZoneBoundaryPoint[]
  addresses Address[]
  orders    Order[]

  @@index([serviceAreaId, isActive])
}

/// Ordered lat/lng vertices forming the zone's polygon boundary.
model DeliveryZoneBoundaryPoint {
  id             String       @id @default(cuid())
  deliveryZoneId String
  deliveryZone   DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)
  sequence       Int
  lat            Decimal      @db.Decimal(9, 6)
  lng            Decimal      @db.Decimal(9, 6)

  @@index([deliveryZoneId, sequence])
}

/// Circular no-delivery zones around sensitive locations (schools,
/// hospitals, etc.) used to block age-restricted product delivery.
model GeographicExclusionZone {
  id            String                 @id @default(cuid())
  name          String
  category      ExclusionZoneCategory
  centerLat     Decimal                @db.Decimal(9, 6)
  centerLng     Decimal                @db.Decimal(9, 6)
  radiusMeters  Int                    @default(100)
  appliesToTobacco Boolean             @default(true)
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

/// Submitted by customers outside any active delivery zone, or outside
/// coverage entirely, so the admin can track expansion demand.
model CoverageRequest {
  id          String                 @id @default(cuid())
  userId      String?
  user        User?                  @relation(fields: [userId], references: [id])
  name        String
  phone       String
  addressText String
  lat         Decimal?               @db.Decimal(9, 6)
  lng         Decimal?               @db.Decimal(9, 6)
  divisionText String?
  districtText String?
  upazilaText  String?
  status      CoverageRequestStatus  @default(PENDING)
  adminNote   String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([status])
}

model Address {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  label           String        @default("Home")
  recipientName   String
  recipientPhone  String
  neighbourhoodId String?
  neighbourhood   Neighbourhood? @relation(fields: [neighbourhoodId], references: [id])
  deliveryZoneId  String?
  deliveryZone    DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  streetOrVillage String
  landmark        String?
  lat             Decimal?      @db.Decimal(9, 6)
  lng             Decimal?      @db.Decimal(9, 6)
  isDefault       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  orders Order[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Vendors, restaurants and applications
// ---------------------------------------------------------------------------

model VendorApplication {
  id                String            @id @default(cuid())
  applicantUserId   String?
  businessName      String
  ownerName         String
  businessType      BusinessType
  phone             String
  email             String
  addressText       String
  deliveryCoverageText String
  tradeLicenseNo    String?
  tradeLicenseDocKey String?          @map("tradeLicenseDocUrl")
  nationalIdNo      String?
  nationalIdDocKey  String?          @map("nationalIdDocUrl")
  bankOrMfsAccount  String?
  productCategories String[]
  openingHoursText  String?
  businessDescription String?
  logoUrl           String?
  coverImageUrl     String?
  paymentMethod     RegistrationPaymentMethod?
  paymentReference  String?
  status            ApplicationStatus @default(DRAFT)
  adminNote         String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  vendor Vendor?
}

model Vendor {
  id                String       @id @default(cuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId     String?      @unique
  application       VendorApplication? @relation(fields: [applicationId], references: [id])
  businessName      String
  slug              String       @unique
  businessType      BusinessType
  logoUrl           String?
  coverImageUrl     String?
  description       String?
  phone             String
  email             String
  addressText       String
  neighbourhoodId   String?
  lat               Decimal?     @db.Decimal(9, 6)
  lng               Decimal?     @db.Decimal(9, 6)
  commissionRatePct Decimal      @default(10) @db.Decimal(5, 2)
  isApproved        Boolean      @default(false)
  isSuspended       Boolean      @default(false)
  suspensionReason  String?
  ratingAvg         Decimal      @default(0) @db.Decimal(2, 1)
  ratingCount       Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  restaurant       Restaurant?
  products         Product[]
  orders           Order[]
  coupons          Coupon[]
  reviews          Review[]
  payouts          VendorPayout[]
  commissionEntries CommissionEntry[]
  restaurantMenus  RestaurantMenu[]
  favoritedBy      FavoriteVendor[]

  @@index([businessType])
  @@index([isApproved, isSuspended])
}

/// Restaurant-only operational settings. Ordinary grocery/essentials
/// vendors never get a row here — they sell 24/7 whenever a product is
/// published and in stock, with no opening-hours concept.
model Restaurant {
  id                    String    @id @default(cuid())
  vendorId              String    @unique
  vendor                Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  cuisineTags           String[]
  minimumOrderAmount    Decimal   @default(0) @db.Decimal(10, 2)
  preparationTimeMinutes Int      @default(20)
  isManuallyClosed      Boolean   @default(false)
  temporaryClosureUntil DateTime?
  scheduledOrderingEnabled Boolean @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  weeklyHours RestaurantWeeklyHours[]
}

model RestaurantWeeklyHours {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dayOfWeek    Int        // 0 = Sunday .. 6 = Saturday
  opensAt      String     // "10:00"
  closesAt     String     // "22:00"
  isClosed     Boolean    @default(false)

  @@unique([restaurantId, dayOfWeek])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id               String     @id @default(cuid())
  parentId         String?
  parent           Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[] @relation("CategoryTree")
  name             String
  nameBn           String?
  slug             String     @unique
  icon             String?
  imageUrl         String?
  isAgeRestricted  Boolean    @default(false)
  isActive         Boolean    @default(true)
  sortOrder        Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  products Product[]

  @@index([isAgeRestricted])
  @@index([isActive, sortOrder])
}

model Product {
  id               String              @id @default(cuid())
  vendorId         String
  vendor           Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId       String
  category         Category            @relation(fields: [categoryId], references: [id])
  name             String
  slug             String
  description      String?
  price            Decimal             @db.Decimal(10, 2)
  compareAtPrice   Decimal?            @db.Decimal(10, 2)
  unit             String              @default("piece")
  sku              String?
  isAgeRestricted  Boolean             @default(false)
  /// Weekly grocery picks — batch-fulfilled, so orders containing one must be
  /// scheduled at least 24h ahead rather than the usual fast/ASAP delivery.
  isWeeklyGrocery  Boolean             @default(false)
  isPublished      Boolean             @default(false)
  availability     ProductAvailability @default(AVAILABLE)
  ratingAvg        Decimal             @default(0) @db.Decimal(2, 1)
  ratingCount      Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  images        ProductImage[]
  variants      ProductVariant[]
  inventory     Inventory?
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]

  @@unique([vendorId, slug])
  @@index([categoryId, isPublished])
  @@index([isAgeRestricted])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int     @default(0)

  variants ProductVariant[]
}

enum VariantUnit {
  ML
  L
  G
  KG
  PCS
  PACK
  DOZEN
}

/// A purchasable size/pack option of a product (e.g. "1 L", "2 x 300 ml").
/// Every product has at least one (see the backfill migration) — there is no
/// "product without variants" code path to special-case anywhere downstream.
/// `name` and `priceDelta` predate this — a partial scaffold that was never
/// wired up — and are kept only so the pre-existing NOT NULL/default
/// constraints don't need touching; nothing reads them anymore.
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  priceDelta Decimal  @default(0) @db.Decimal(10, 2)
  stockQty   Int      @default(0)
  isDefault  Boolean  @default(false)

  /// The base size, e.g. 300 for "300 ml" or "2 x 300 ml".
  quantityValue Decimal     @db.Decimal(10, 3)
  unit          VariantUnit
  /// How many of `quantityValue`/`unit` are bundled in this option — 1 for a
  /// plain size ("300 ml"), >1 for a multipack ("2 x 300 ml"). Independent of
  /// `quantityValue`/`unit`, which stay the same across a product's packs —
  /// see AVAILABLE_PACK_COUNTS and the vendor form's "+ N pack" buttons.
  packCount      Int      @default(1)
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  sku            String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  imageId        String?
  image          ProductImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, isActive])
}

model Inventory {
  id                String   @id @default(cuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityInStock   Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Restaurant menu (separate from the grocery/essentials catalog above)
// ---------------------------------------------------------------------------

model RestaurantMenu {
  id        String     @id @default(cuid())
  vendorId  String
  vendor    Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items MenuItem[]
}

model MenuItem {
  id                String   @id @default(cuid())
  menuId            String
  menu              RestaurantMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  price             Decimal  @db.Decimal(10, 2)
  imageUrl          String?
  isAvailable       Boolean  @default(true)
  allowsInstructions Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  addOnGroups AddOnGroup[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model AddOnGroup {
  id           String     @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name         String     // e.g. "Choose your spice level"
  isRequired   Boolean    @default(false)
  maxSelect    Int        @default(1)
  addOns       AddOn[]
}

model AddOn {
  id           String     @id @default(cuid())
  groupId      String
  group        AddOnGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name         String
  priceDelta   Decimal    @default(0) @db.Decimal(10, 2)
}

// ---------------------------------------------------------------------------
// Cart & wishlist
// ---------------------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id                 String    @id @default(cuid())
  cartId             String
  cart               Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product?  @relation(fields: [productId], references: [id])
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id])
  menuItemId         String?
  menuItem           MenuItem? @relation(fields: [menuItemId], references: [id])
  quantity           Int       @default(1)
  selectedAddOns     Json?
  specialInstructions String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Wishlist {
  id     String         @id @default(cuid())
  userId String         @unique
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
}

/// Customer's favorited shops (restaurants or grocery vendors) — direct
/// user-vendor link, unlike Wishlist which wraps products in a collection.
model FavoriteVendor {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, vendorId])
}

// ---------------------------------------------------------------------------
// Orders — checkout produces one OrderGroup, split into one Order per
// vendor so multi-vendor carts settle independently.
// ---------------------------------------------------------------------------

model OrderGroup {
  id              String   @id @default(cuid())
  groupNumber     String   @unique
  customerId      String
  customer        User     @relation(fields: [customerId], references: [id])
  subtotal        Decimal  @db.Decimal(10, 2)
  deliveryFeeTotal Decimal @db.Decimal(10, 2)
  discountTotal   Decimal  @default(0) @db.Decimal(10, 2)
  taxTotal        Decimal  @default(0) @db.Decimal(10, 2)
  grandTotal      Decimal  @db.Decimal(10, 2)
  couponCode      String?
  scheduledFor    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders  Order[]
  payment Payment?
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique
  orderGroupId    String
  orderGroup      OrderGroup   @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)
  customerId      String
  customer        User         @relation("CustomerOrders", fields: [customerId], references: [id])
  vendorId        String
  vendor          Vendor       @relation(fields: [vendorId], references: [id])
  addressId       String
  address         Address      @relation(fields: [addressId], references: [id])
  deliveryZoneId  String
  deliveryZone    DeliveryZone @relation(fields: [deliveryZoneId], references: [id])
  status          OrderStatus  @default(ORDER_PLACED)
  subtotal        Decimal      @db.Decimal(10, 2)
  deliveryFee     Decimal      @db.Decimal(10, 2)
  discount        Decimal      @default(0) @db.Decimal(10, 2)
  tax             Decimal      @default(0) @db.Decimal(10, 2)
  total           Decimal      @db.Decimal(10, 2)
  // Which free-delivery offer (if any) zeroed deliveryFee below, captured at
  // placement time — so admin/order-detail can honestly label a Tk 0 fee
  // instead of guessing from today's settings, which may have changed since.
  // Null whenever deliveryFee wasn't waived by a promo.
  freeDeliveryReason String?
  commissionRatePct Decimal    @db.Decimal(5, 2)
  commissionAmount  Decimal    @db.Decimal(10, 2)
  vendorEarnings    Decimal    @db.Decimal(10, 2)
  // Snapshot of the delivery zone's standard fee AT ORDER PLACEMENT, in
  // poisha — so a later zone-fee change never affects an in-flight order.
  // The rider's delivery earning is always computed from this value, never
  // from `deliveryFee` below (which may be reduced by a coupon/promo).
  // Nullable only because orders placed before this column existed won't
  // have it — see lib/rider/ledger.ts for the fallback.
  standardDeliveryFeePoisha Int?
  containsAgeRestrictedItems Boolean @default(false)
  customerNote    String?
  scheduledFor    DateTime?
  /// Set when the vendor hits "Wait" on a new order instead of Accept/Reject —
  /// order stays ORDER_PLACED, customer sees a "restaurant is busy" notice
  /// until this passes, then it re-enters the vendor's incoming-order alert.
  vendorWaitUntil DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items           OrderItem[]
  statusHistory   DeliveryStatusHistory[]
  delivery        Delivery?
  reviews         Review[]
  couponRedemptions CouponRedemption[]
  commissionEntry CommissionEntry?
  ageVerification AgeVerification?

  @@index([customerId])
  @@index([vendorId, status])
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product? @relation(fields: [productId], references: [id])
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id])
  menuItemId         String?
  menuItem           MenuItem? @relation(fields: [menuItemId], references: [id])
  nameSnapshot        String
  unitPriceSnapshot  Decimal  @db.Decimal(10, 2)
  quantity           Int
  selectedAddOns     Json?
  specialInstructions String?
  lineTotal          Decimal  @db.Decimal(10, 2)
}

model Delivery {
  id              String       @id @default(cuid())
  orderId         String       @unique
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId         String?
  rider           RiderProfile? @relation(fields: [riderId], references: [id])
  pickupLat       Decimal?     @db.Decimal(9, 6)
  pickupLng       Decimal?     @db.Decimal(9, 6)
  dropLat         Decimal?     @db.Decimal(9, 6)
  dropLng         Decimal?     @db.Decimal(9, 6)
  distanceKm      Decimal?     @db.Decimal(6, 2)
  etaMinutes      Int?
  assignedAt      DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  isTrackingActive Boolean     @default(false)
  // Set when a vendor clicks "Find rider" — riders only see this delivery in
  // their available-deliveries list once this is non-null (never reset;
  // re-clicking "Find rider" just bumps it to notify everyone again).
  riderSearchStartedAt DateTime?
  // Snapshot fields, written once when the ledger DELIVERY_EARNING entry is
  // created (see lib/actions/orders.ts) — never recomputed afterward, so a
  // later change to the rider's commissionRatePct never rewrites history.
  riderRatePctSnapshot        Decimal? @db.Decimal(5, 2)
  deliveryFeePoisha           Int?
  riderEarningPoisha          Int?
  platformDeliverySharePoisha Int?
  isCod                       Boolean?
  orderTotalPoisha            Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  locationUpdates RiderLocationUpdate[]
  restrictedLog   RestrictedDeliveryLog?
  ledgerEntries   RiderLedgerEntry[]
}

model DeliveryStatusHistory {
  id             String      @id @default(cuid())
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         OrderStatus
  note           String?
  changedByUserId String?
  changedByUser  User?       @relation("StatusChangedBy", fields: [changedByUserId], references: [id])
  createdAt      DateTime    @default(now())

  @@index([orderId, createdAt])
}

enum RiderLedgerEntryType {
  DELIVERY_EARNING
  DELIVERY_REVERSAL
  CASH_HANDOVER
  PAYOUT
  ADJUSTMENT
}

/// Append-only running ledger of rider money. Corrections are new rows
/// (ADJUSTMENT / DELIVERY_REVERSAL), never edits or deletes — see
/// lib/rider/ledger.ts for the sign convention and rounding rule.
///
/// Two uniqueness rules are enforced as PARTIAL indexes in migration SQL
/// (Prisma's schema DSL can't express a WHERE-qualified unique constraint):
///   CREATE UNIQUE INDEX ... ON "RiderLedgerEntry" ("deliveryId") WHERE "type" = 'DELIVERY_EARNING'
///   CREATE UNIQUE INDEX ... ON "RiderLedgerEntry" ("deliveryId") WHERE "type" = 'DELIVERY_REVERSAL'
/// — so a delivery can have at most one earning entry and at most one
/// reversal entry, no matter how many times "mark delivered" fires.
model RiderLedgerEntry {
  id          String               @id @default(cuid())
  riderId     String
  rider       RiderProfile         @relation(fields: [riderId], references: [id])
  type        RiderLedgerEntryType
  deliveryId  String?
  delivery    Delivery?            @relation(fields: [deliveryId], references: [id])
  // Signed, in poisha. Positive = increases what the rider owes the platform;
  // negative = decreases it (increases what the platform owes the rider).
  balanceImpactPoisha Int
  // Unsigned magnitude, for display — always > 0.
  amountPoisha        Int
  payoutMethod        String?
  referenceNo         String?
  note                String?
  occurredAt          DateTime  @default(now())
  createdByUserId     String?
  createdByUser       User?     @relation(fields: [createdByUserId], references: [id])
  // Client-generated, stable per form-mount — a resubmission of the same
  // in-flight admin form (handover/payout/adjustment) carries the same key,
  // so a duplicate insert is caught by this unique constraint instead of
  // double-recording the entry. Null for system-generated entries
  // (DELIVERY_EARNING / DELIVERY_REVERSAL), which are already protected by
  // the partial indexes above.
  idempotencyKey      String?   @unique
  createdAt           DateTime  @default(now())

  @@index([riderId, createdAt])
  @@index([deliveryId])
}

/// Live rider GPS pings, kept only while a delivery is active. A retention
/// job purges rows past expiresAt so precise location history is not kept
/// indefinitely.
model RiderLocationUpdate {
  id         String   @id @default(cuid())
  riderId    String
  rider      RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  lat        Decimal  @db.Decimal(9, 6)
  lng        Decimal  @db.Decimal(9, 6)
  recordedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([deliveryId, recordedAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id            String          @id @default(cuid())
  orderGroupId  String          @unique
  orderGroup    OrderGroup      @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)
  provider      PaymentProvider
  status        PaymentStatus   @default(PENDING)
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("BDT")
  isSandbox     Boolean         @default(true)
  providerRef   String?
  idempotencyKey String?        @unique
  rawPayload    Json?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  transactions Transaction[]
  refunds      Refund[]
}

model Transaction {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type      String   // charge | refund | payout
  amount    Decimal  @db.Decimal(10, 2)
  status    PaymentStatus
  metadata  Json?
  createdAt DateTime @default(now())
}

model Refund {
  id        String       @id @default(cuid())
  paymentId String
  payment   Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount    Decimal      @db.Decimal(10, 2)
  reason    String
  status    RefundStatus @default(REQUESTED)
  processedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// ---------------------------------------------------------------------------
// Coupons
// ---------------------------------------------------------------------------

model Coupon {
  id               String     @id @default(cuid())
  code             String     @unique
  vendorId         String?
  vendor           Vendor?    @relation(fields: [vendorId], references: [id])
  type             CouponType
  value            Decimal    @db.Decimal(10, 2)
  minOrderAmount   Decimal    @default(0) @db.Decimal(10, 2)
  maxDiscountAmount Decimal?  @db.Decimal(10, 2)
  startsAt         DateTime
  endsAt           DateTime
  usageLimit       Int?
  perCustomerLimit Int        @default(1)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  discountApplied Decimal @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@unique([couponId, orderId])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @default(cuid())
  customerId String
  customer  User     @relation(fields: [customerId], references: [id])
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  vendorId  String?
  vendor    Vendor?  @relation(fields: [vendorId], references: [id])
  rating    Int
  comment   String?
  vendorReply String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([vendorId])
}

// ---------------------------------------------------------------------------
// Commission & payouts
// ---------------------------------------------------------------------------

model CommissionEntry {
  id                String   @id @default(cuid())
  orderId           String   @unique
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  ratePct           Decimal  @db.Decimal(5, 2)
  commissionAmount  Decimal  @db.Decimal(10, 2)
  vendorEarnings    Decimal  @db.Decimal(10, 2)
  isAdjustedForRefund Boolean @default(false)
  createdAt         DateTime @default(now())
}

model VendorPayout {
  id          String       @id @default(cuid())
  vendorId    String
  vendor      Vendor       @relation(fields: [vendorId], references: [id])
  amount      Decimal      @db.Decimal(10, 2)
  status      PayoutStatus @default(PENDING)
  periodStart DateTime
  periodEnd   DateTime
  requestedAt DateTime     @default(now())
  processedAt DateTime?
  payoutMethod String?
  referenceNo  String?
  adminNote    String?
}

// ---------------------------------------------------------------------------
// Notifications & support
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  linkUrl   String?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model SupportTicket {
  id          String              @id @default(cuid())
  requesterId String?
  requester   User?               @relation("TicketRequester", fields: [requesterId], references: [id])
  name        String
  email       String
  phone       String?
  subject     String
  category    String
  status      SupportTicketStatus @default(OPEN)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  messages SupportTicketMessage[]
}

model SupportTicketMessage {
  id        String         @id @default(cuid())
  ticketId  String
  ticket    SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?          @relation(fields: [authorId], references: [id])
  message   String
  createdAt DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Advertising platform
// ---------------------------------------------------------------------------

model Advertiser {
  id           String   @id @default(cuid())
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id])
  advertiserName String
  businessName String
  phone        String
  /// Optional — the redesigned /advertise form only collects a phone number.
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  advertisements Advertisement[]
}

model AdPlacement {
  id            String          @id @default(cuid())
  code          AdPlacementCode @unique
  name          String
  description   String?
  desktopWidth  Int
  desktopHeight Int
  mobileWidth   Int
  mobileHeight  Int
  isActive      Boolean         @default(true)
  /// Max campaigns allowed to overlap on any given day in this placement —
  /// enforced when a campaign is created/its dates edited/it's resumed, so
  /// an already-approved-and-paid campaign is never later hidden by this.
  maxConcurrentAds Int          @default(6)

  pricing   AdPricing[]
  campaigns AdCampaign[]
}

model AdPricing {
  id          String         @id @default(cuid())
  placementId String
  placement   AdPlacement    @relation(fields: [placementId], references: [id], onDelete: Cascade)
  billingCycle AdBillingCycle
  price       Decimal        @db.Decimal(10, 2)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  @@unique([placementId, billingCycle])
}

model Advertisement {
  id              String     @id @default(cuid())
  advertiserId    String
  advertiser      Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  title           String
  description     String
  targetUrl       String
  /// Public URL — set only after approval, when the image is copied out of
  /// the private bucket (see pendingBannerImageKey). Null before that.
  bannerImageUrl  String?
  /// Private-bucket storage key for an uploaded-but-not-yet-approved ad
  /// image — never publicly reachable. Cleared (and the object deleted)
  /// once the advertisement is approved or rejected.
  pendingBannerImageKey String?
  preferredPlacementCode AdPlacementCode
  /// The dates the advertiser originally asked for on /advertise — shown on
  /// "My ads" before an admin creates the real AdCampaign (whose startDate/
  /// endDate become authoritative, and may differ, once one exists).
  requestedStartDate DateTime?
  requestedEndDate   DateTime?
  budget          Decimal    @db.Decimal(10, 2)
  paymentMethod   PaymentProvider
  agreementAccepted Boolean  @default(false)
  status          AdStatus   @default(DRAFT)
  rejectionReason String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  campaigns AdCampaign[]
}

model AdCampaign {
  id              String      @id @default(cuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  placementId     String
  placement       AdPlacement @relation(fields: [placementId], references: [id])
  startDate       DateTime
  endDate         DateTime
  status          AdStatus    @default(SCHEDULED)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  payments    AdPayment[]
  impressions AdImpression[]
  clicks      AdClick[]

  @@index([placementId, status, startDate, endDate])
}

model AdPayment {
  id         String          @id @default(cuid())
  campaignId String
  campaign   AdCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  amount     Decimal         @db.Decimal(10, 2)
  provider   PaymentProvider
  status     AdPaymentStatus @default(PENDING)
  providerRef String?
  isSandbox  Boolean         @default(true)
  paidAt     DateTime?
  createdAt  DateTime        @default(now())
}

model AdImpression {
  id         String     @id @default(cuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  occurredAt DateTime   @default(now())

  @@index([campaignId, occurredAt])
}

model AdClick {
  id         String     @id @default(cuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  occurredAt DateTime   @default(now())

  @@index([campaignId, occurredAt])
}

// ---------------------------------------------------------------------------
// Age-restricted products (tobacco module) — disabled platform-wide until
// legal/compliance review turns TOBACCO_SALES_ENABLED on.
// ---------------------------------------------------------------------------

model AgeRestrictedProductSetting {
  id                    String   @id @default(cuid())
  tobaccoSalesEnabled   Boolean  @default(false)
  minimumAge            Int      @default(18)
  exclusionRadiusMeters Int      @default(100)
  healthWarningText     String?
  updatedAt             DateTime @updatedAt
}

model AgeVerification {
  id                String                @id @default(cuid())
  orderId           String                @unique
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId        String
  customer          User                  @relation(fields: [customerId], references: [id])
  dateOfBirthOnFile DateTime
  confirmedAtCheckout Boolean             @default(false)
  minimumAgeApplied Int
  result            AgeVerificationResult @default(NOT_ATTEMPTED)
  createdAt         DateTime              @default(now())
}

/// Delivery-time compliance record for age-restricted orders. Deliberately
/// does not store copies of ID documents — only the document type checked
/// and the outcome.
model RestrictedDeliveryLog {
  id               String         @id @default(cuid())
  deliveryId       String         @unique
  delivery         Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  riderId          String
  rider            RiderProfile   @relation(fields: [riderId], references: [id])
  idDocumentType   IdDocumentType?
  verificationResult AgeVerificationResult @default(NOT_ATTEMPTED)
  wasRejected      Boolean        @default(false)
  rejectionReason  String?
  exclusionZoneChecked Boolean    @default(false)
  notes            String?
  createdAt        DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Platform-wide config & audit
// ---------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actorUser    User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  action       String
  entityType   String
  entityId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
